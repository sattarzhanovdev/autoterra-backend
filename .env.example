HF_API_TOKEN=hf_your_token_here
HF_CHAT_MODEL=openai/gpt-oss-120b
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions

# Email (SMTP) — new-order notifications, sent FROM a Gmail account.
# Leave EMAIL_HOST_USER/PASSWORD empty to fall back to the console backend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Gmail address (sender) and a Google App Password (16 chars)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Comma-separated list of recipients for new-order emails
ORDER_NOTIFICATION_EMAILS=izvenshikov@yandex.ru

# ── Оплата: YooKassa (ЮKassa / YooMoney для бизнеса) ──────────────────────────
# Берутся в ЛК ЮKassa: https://yookassa.ru/my → Настройки → Магазин.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернётся пользователь после оплаты (deep-link/веб-страница)
YOOKASSA_RETURN_URL=https://autoterra.shop/api/payments/yookassa/return/
# URL этого бэкенда для webhook: https://<домен>/api/payments/yookassa/webhook/
# Redirect-сценарий: мобильный SDK не используется, его ключ не требуется.
# YOOKASSA_MOBILE_SDK_KEY оставьте пустым; сервер этот параметр не читает.

# Production. Set a newly generated secret (50+ random characters).
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=autoterra.shop
CORS_ALLOWED_ORIGINS=https://autoterra.shop
CSRF_TRUSTED_ORIGINS=https://autoterra.shop
SECURE_SSL_REDIRECT=True
DB_ENGINE=postgresql
DB_NAME=autoterra
DB_USER=autoterra
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
ORDER_RESERVATION_TTL_HOURS=24
FCM_SERVICE_ACCOUNT_FILE=/etc/autoterra/firebase-service-account.json
