HF_API_TOKEN=hf_your_token_here
HF_CHAT_MODEL=openai/gpt-oss-120b
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions

# Email (SMTP) — new-order notifications, sent FROM a Gmail account.
# Leave EMAIL_HOST_USER/PASSWORD empty to fall back to the console backend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Gmail address (sender) and a Google App Password (16 chars)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Comma-separated list of recipients for new-order emails
ORDER_NOTIFICATION_EMAILS=izvenshikov@yandex.ru

# ── Оплата: YooKassa (ЮKassa / YooMoney для бизнеса) ──────────────────────────
# Берутся в ЛК ЮKassa: https://yookassa.ru/my → Настройки → Магазин.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернётся пользователь после оплаты (deep-link/веб-страница)
YOOKASSA_RETURN_URL=https://autoterra.ru/payment/return
# URL этого бэкенда для webhook: https://<домен>/api/payments/yookassa/webhook/
