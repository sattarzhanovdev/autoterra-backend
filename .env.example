HF_API_TOKEN=hf_your_token_here
HF_CHAT_MODEL=openai/gpt-oss-120b:groq
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions
HF_CHAT_TIMEOUT=45

# Email (SMTP) — new-order notifications, sent FROM a Gmail account.
# Leave EMAIL_HOST_USER/PASSWORD empty to fall back to the console backend.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Gmail address (sender) and a Google App Password (16 chars)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Comma-separated list of recipients for new-order emails
ORDER_NOTIFICATION_EMAILS=izvenshikov@yandex.ru
REGISTRATION_NOTIFICATION_EMAILS=zavtoterra@yandex.ru

# ── Оплата: YooKassa (ЮKassa / YooMoney для бизнеса) ──────────────────────────
# Берутся в ЛК ЮKassa: https://yookassa.ru/my → Настройки → Магазин.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Адрес для чека, если клиент не указал email; настройте действующий ящик.
YOOKASSA_RECEIPT_EMAIL=
# Куда вернётся пользователь после оплаты (deep-link/веб-страница)
YOOKASSA_RETURN_URL=https://autoterra.shop/api/payments/yookassa/return/
# Разрешённые HTTPS-origin через запятую, без путей и wildcard; пусто запрещает returnUrl.
# Например: https://avtoterra.vercel.app,https://autoterra.shop
YOOKASSA_WEB_RETURN_ORIGINS=
# URL этого бэкенда для webhook: https://<домен>/api/payments/yookassa/webhook/
# Redirect-сценарий: мобильный SDK не используется, его ключ не требуется.
# YOOKASSA_MOBILE_SDK_KEY оставьте пустым; сервер этот параметр не читает.

# Production. Set a newly generated secret (50+ random characters).
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=autoterra.shop
CORS_ALLOWED_ORIGINS=https://autoterra.shop
CSRF_TRUSTED_ORIGINS=https://autoterra.shop
SECURE_SSL_REDIRECT=True
DB_ENGINE=postgresql
DB_NAME=autoterra
DB_USER=autoterra
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
ORDER_RESERVATION_TTL_HOURS=24
FCM_SERVICE_ACCOUNT_FILE=/etc/autoterra/firebase-service-account.json

# Private knowledge documents: keep outside media and web-server public aliases.
PRIVATE_KNOWLEDGE_ROOT=/var/lib/autoterra/knowledge
# Existing HF_API_TOKEN is a secret; set it only on the server.

# AI knowledge sync: public folder, Anyone with the link / Viewer.
GOOGLE_DRIVE_KNOWLEDGE_FOLDER_ID=1mUIX2or26vC23eSw_ej9ZRf_AkZfAkaI
GOOGLE_DRIVE_API_KEY=
# Optional OAuth mode for private folders / Google Docs and Sheets export.
# Leave empty to use GOOGLE_DRIVE_API_KEY. Never use Firebase credentials here.
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_REQUEST_TIMEOUT=30
GOOGLE_DRIVE_DOWNLOAD_TIMEOUT=120
GOOGLE_DRIVE_MAX_FILES=10000

# Optional small vocabulary extension for AI retrieval (JSON object of alias lists).
AI_DOMAIN_SYNONYMS={}
